# ============================================================
# .env for US Machine (Production)
# Copy this to the hiring-cafe-engine folder on the US machine
# Rename this file to: .env
# ============================================================

# Database Configuration
DUCKDB_PATH=data/job_engine.duckdb

# Browser Settings
CHROME_USER_DATA_DIR=./chrome_profile
HEADLESS=false

# Proxy Settings (Optional - add a US proxy if needed)
PROXY_URL=

# Safety Limits
MAX_APPLICATIONS_PER_RUN=10
SUBMISSION_COOLDOWN_SECONDS=30
DRY_RUN=false

# Keywords to search on hiring.cafe
INSIGHT_KEYWORDS=AI Engineer
INSIGHT_LOCATIONS=
INSIGHT_DISTANCE_DEFAULT=

# Resume (optional)
RESUME_FILE_PATH=resume/candidate_resume.pdf

# ============================================================
# PRODUCTION API - Points to the live deployed backend
# ============================================================
AUTH_URL=https://api.whitebox-learning.com/api/login
AUTH_USERNAME=sairam818595@gmail.com
AUTH_PASSWORD=Innovapath@1

# Scheduler time (not used for Task Scheduler, just for standalone scheduler.py)
# EST timezone: 2:00 AM EST = 07:30 UTC = 13:00 IST
SCHEDULER_TIME=02:00
